import React from 'react';
import { useLanguage } from '@/contexts/LanguageContext';
import { Button } from '@/components/ui/button';
import { Languages } from 'lucide-react';
import {
  DropdownMenu,
  DropdownMenuContent,
  DropdownMenuItem,
  DropdownMenuTrigger,
} from "@/components/ui/dropdown-menu";

export const LanguageSwitcher: React.FC = () => {
  const { language, setLanguage } = useLanguage();

  return (
    <DropdownMenu>
      <DropdownMenuTrigger
        render={
          <Button variant="ghost" size="sm" className="flex items-center gap-2 text-gray-600 hover:text-green-600">
            <Languages className="w-4 h-4" />
            <span className="text-xs font-medium uppercase">{language}</span>
          </Button>
        }
      />
      <DropdownMenuContent align="end">
        <DropdownMenuItem 
          onClick={() => setLanguage('bn')}
          className={language === 'bn' ? 'bg-green-50 text-green-700 font-bold' : ''}
        >
          বাংলা (Bangla)
        </DropdownMenuItem>
        <DropdownMenuItem 
          onClick={() => setLanguage('en')}
          className={language === 'en' ? 'bg-green-50 text-green-700 font-bold' : ''}
        >
          English
        </DropdownMenuItem>
      </DropdownMenuContent>
    </DropdownMenu>
  );
};
